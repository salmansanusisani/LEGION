# The OpenCode server started by scripts/start-opencode.sh
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Keep 0 while rehearsing. Set to 1 only for an isolated official run;
# it auto-accepts OpenCode permissions and auto-rejects clarifying questions.
BAND_AUTONOMOUS=0

# Defaults supplied by the SDK are normally correct.
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_REST_URL=https://app.band.ai

